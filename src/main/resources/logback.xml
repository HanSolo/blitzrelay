<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>false</withJansi>
        <encoder>
            <pattern>%cyan(%d{dd.MM.yyyy HH:mm:ss}) %gray([%thread]) %highlight(%-5level) %magenta(%logger{36}.%M %L) - %msg%n</pattern>
        </encoder>
    </appender>

    <property name="DOCKER_VOLUME" value="/docker_logs" />
    <property name="LOG_FILE" value="blitzrelay" />
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${DOCKER_VOLUME}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>${DOCKER_VOLUME}/${LOG_FILE}.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <!--<maxFileSize>100MB</maxFileSize>-->

            <!-- keep 5 days' worth of history capped at 3GB total size -->
            <maxHistory>5</maxHistory>
            <totalSizeCap>128MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{dd.MM.yyyy HH:mm:ss} [%thread] %-5level %logger{36}.%M %L - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="eu.hansolo" level="DEBUG" additivity="false">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE"/>
    </logger>

    <root level="debug">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>
</configuration>